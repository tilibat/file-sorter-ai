# Конфигурация AI-сортировщика файлов
# Configuration for AI file sorter

# Путь к папке для сортировки (по умолчанию ~/Downloads)
# Path to the folder for sorting (default ~/Downloads)
SOURCE_FOLDER=

# OpenAI API ключ для умного переименования (опционально)
# OpenAI API key for smart renaming (optional)
OPENAI_API_KEY=

# Режим отладки (True/False)
# Debug mode (True/False)
DEBUG=False
